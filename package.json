{
  "name": "dsh-background-task-engine",
  "version": "1.0.3",
  "description": "DSH 后台任务引擎：可复用任务模板、线性步骤、持久化运行账本、进度与历史查询、失败/中断恢复，可选关联 DSH 原生定时任务。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "task-engine",
    "background-task",
    "task-orchestration",
    "schedule"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "yzzshanyin-rgb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzzshanyin-rgb/dsh-background-task-engine.git"
  },
  "homepage": "https://github.com/yzzshanyin-rgb/dsh-background-task-engine#readme",
  "bugs": {
    "url": "https://github.com/yzzshanyin-rgb/dsh-background-task-engine/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  }
}
